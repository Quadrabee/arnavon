{
  "name": "@quadrabee/arnavon",
  "description": "Framework on top of RabbitMQ for easing up the development of producer/consumer/job queues.",
  "version": "1.3.1",
  "author": "Louis Lambeau <llambeau@quadrabee.com>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arnavon": "./bin/run"
  },
  "files": [
    "/bin",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json",
    "/dist",
    "/src"
  ],
  "bugs": "https://github.com/quadrabee/arnavon/issues",
  "scripts": {
    "test": "mocha tests",
    "test:watch": "mocha --watch tests",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "tsc --noEmit && eslint . --fix",
    "build": "shx rm -rf dist && tsc",
    "build:watch": "tsc --watch",
    "postpack": "shx rm -f oclif.manifest.json",
    "prepack": "npm run build && oclif manifest && oclif readme",
    "version": "echo $npm_package_version",
    "package": "pkg . --out-path pkg/"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oclif/test": "^4.1.22",
    "@types/bunyan": "^1.8.11",
    "@types/command-exists": "^1.2.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.0",
    "@types/sinon": "^22.0.0",
    "@types/sinon-chai": "^4.0.0",
    "@yao-pkg/pkg": "^6.22.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "chai-http": "^5.1.2",
    "eslint": "^10.0.2",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "globals": "^17.11.0",
    "mocha": "^11.8.0",
    "mocha-junit-reporter": "^2.2.1",
    "nodemailer": "^9.0.5",
    "nyc": "^18.0.0",
    "oclif": "^4.23.30",
    "shx": "^0.4.0",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "uuid": "^14.0.1"
  },
  "dependencies": {
    "@oclif/core": "^4.13.5",
    "@oclif/plugin-help": "^6.2.58",
    "@oclif/table": "^0.5.9",
    "amqplib": "^2.0.1",
    "bunyan": "^1.8.15",
    "command-exists": "^1.2.9",
    "express": "^5.2.1",
    "express-prom-bundle": "^8.0.0",
    "finitio": "^1.3.7",
    "prom-client": "^15.1.3",
    "tsx": "^4.23.12",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "oclif": {
    "commands": "./dist/cli/commands",
    "bin": "arnavon",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "pkg": {
    "scripts": [
      "bin/**/*.js",
      "dist/**/*.js"
    ],
    "targets": [
      "node20-linux",
      "node20-macos-x64",
      "node20-win"
    ]
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.0"
  }
}
